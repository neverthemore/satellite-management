            "body": {
              "mode": "raw",
              "raw": "{\n  \"constellationName\": \"{{deployConstellationName}}\",\n  \"satelliteParams\": [\n    {\n      \"type\": \"IMAGE\",\n      \"name\": \"RECON-1\",\n      \"batteryLevel\": 1.0,\n      \"resolution\": 0.3\n    }\n  ]\n}",
              "options": {
