                "{{constellationName}}",
                "report"
              ]
            },
            "description": "Краткий отчёт: constellationName, totalSatellites, activeSatellites."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
