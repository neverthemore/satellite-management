                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Логика статуса температуры соответствует значению internalTemperature', function () {",
                  "    const t = pm.response.json();",
                  "    if (t.internalTemperature === null) {",
                  "        pm.expect(t.temperatureStatus).to.eql('NO_DATA');",
                  "    } else if (t.internalTemperature < 15.0) {",
                  "        pm.expect(t.temperatureStatus).to.eql('TOO_COLD');",
                  "    } else if (t.internalTemperature > 40.0) {",
                  "        pm.expect(t.temperatureStatus).to.eql('OVERHEATING');",
                  "    } else {",
                  "        pm.expect(t.temperatureStatus).to.eql('NOMINAL');",
                  "    }",
                  "});"
                ]
