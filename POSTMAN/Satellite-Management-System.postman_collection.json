    {
      "name": "3. Satellites CRUD",
      "description": "Прямое чтение спутников (SatelliteController)",
      "item": [
        {
          "name": "Получить все спутники",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/satellites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "satellites"
              ]
            },
            "description": "Список всех спутников во всех группировках."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Ответ - массив, и если непустой - сохраняем id первого элемента', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    if (json.length > 0) {",
                  "        pm.collectionVariables.set('satelliteId', json[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить спутник по ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/satellites/{{satelliteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "satellites",
                "{{satelliteId}}"
              ]
            },
            "description": "satelliteId берётся из переменной коллекции (заполняется предыдущим запросом или вручную)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
