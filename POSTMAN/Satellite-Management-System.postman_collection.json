    {
      "name": "2. Space Operation Center",
      "description": "Фасад высокого уровня: добавление спутников, миссии, деплой, сводки (SpaceOperationController)",
      "item": [
        {
          "name": "Добавить спутники в группировку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/add-satellites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "add-satellites"
              ]
            },
            "description": "Добавляет коммуникационный и съёмочный спутники в группировку (создаёт группировку, если её нет).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"constellationName\": \"{{constellationName}}\",\n  \"satelliteParams\": [\n    {\n      \"type\": \"COMMUNICATION\",\n      \"name\": \"{{commSatName}}\",\n      \"batteryLevel\": 0.95,\n      \"bandwidth\": 150.0\n    },\n    {\n      \"type\": \"IMAGE\",\n      \"name\": \"{{imgSatName}}\",\n      \"batteryLevel\": 0.9,\n      \"resolution\": 0.5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Возвращены имена обоих добавленных спутников', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array').that.includes(",
                  "        pm.collectionVariables.get('commSatName'),",
                  "        pm.collectionVariables.get('imgSatName')",
                  "    );",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Добавить спутник с некорректным типом (400/422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/add-satellites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "add-satellites"
              ]
            },
            "description": "Отправка неподдерживаемого/некорректного значения type в теле запроса - Jackson не сможет десериализовать полиморфный SatelliteParam.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"constellationName\": \"{{constellationName}}\",\n  \"satelliteParams\": [\n    {\n      \"type\": \"UNKNOWN_TYPE\",\n      \"name\": \"BAD-SAT\",\n      \"batteryLevel\": 0.5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 4xx или 500 (ошибка десериализации/валидации)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422, 500]);",
                  "});"
                ]
              }
            }
          ]
        },
