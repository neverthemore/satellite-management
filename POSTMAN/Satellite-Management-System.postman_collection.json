{
  "info": {
    "_postman_id": "5018b237-3a16-41d8-abb1-84dbe0248614",
    "name": "Satellite Management System API",
    "description": "Коллекция запросов для тестирования Satellite Management System (Spring Boot).\n\nСформирована на основе OpenAPI-спецификации проекта (openapi.yaml).\n\nСтруктура:\n- Constellations CRUD - создание/чтение/удаление группировок\n- Satellites CRUD - чтение спутников\n- Space Operation Center - добавление спутников, выполнение миссий, деплой, сводки, деактивация\n- Telemetry - данные телеметрии (из gRPC-стрима)\n\nПеременные окружения: baseUrl, constellationName, commSatName, imgSatName, satelliteId.\nВ Tests-скриптах используются переменные коллекции для передачи id/имён между запросами (chaining).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Constellations CRUD",
      "description": "Прямое управление группировками (ConstellationController)",
      "item": [
        {
          "name": "Создать группировку",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/constellations?name={{constellationName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "constellations"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "{{constellationName}}"
                }
              ]
            },
            "description": "Создаёт новую группировку. Имя берётся из переменной коллекции constellationName."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Тело ответа содержит правильное имя группировки', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.constellationName).to.eql(pm.collectionVariables.get('constellationName'));",
                  "    pm.expect(json).to.have.property('id');",
                  "});",
                  "",
                  "pm.collectionVariables.set('createdConstellationId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать группировку повторно (ожидаем 422)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/constellations?name={{constellationName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "constellations"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "{{constellationName}}"
                }
              ]
            },
            "description": "Повторное создание группировки с тем же именем должно вернуть 422 (SpaceOperationException)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test('Тело ответа содержит структуру ошибки', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('error');",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json).to.have.property('timestamp');",
                  "    pm.expect(json.message).to.include('уже существует');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить все группировки",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/constellations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "constellations"
              ]
            },
            "description": "Возвращает список всех группировок."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Ответ - массив', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Созданная ранее группировка присутствует в списке', function () {",
                  "    const json = pm.response.json();",
                  "    const names = json.map(c => c.constellationName);",
                  "    pm.expect(names).to.include(pm.collectionVariables.get('constellationName'));",
                  "});"
                ]
              }
            }
          ]
        },
