                  "});",
                  "",
                  "pm.test('Возвращён список развёрнутых спутников', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array').with.length.greaterThan(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Получить сводку по всем группировкам (overview)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overview"
              ]
            },
            "description": "Возвращает totalConstellations и карту группировок с числом спутников (всего/активных)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Есть поля totalConstellations и constellations', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('totalConstellations');",
                  "    pm.expect(json).to.have.property('constellations');",
                  "});",
                  "",
                  "pm.test('totalConstellations соответствует размеру constellations', function () {",
                  "    const json = pm.response.json();",
